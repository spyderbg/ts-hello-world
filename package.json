{
  "name": "ts-hello-world",
  "version": "1.0.0",
  "private": true,
  "description": "A standalone Hello World app with a Vue 3 frontend and a local TypeScript backend",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && tsx scripts/build.ts",
    "start": "node build/server.cjs",
    "package": "npm run build && tsx scripts/package.ts",
    "package:linux": "npm run build && tsx scripts/package.ts --target linux",
    "package:windows": "npm run build && tsx scripts/package.ts --target windows"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "esbuild": "^0.25.0",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vue-tsc": "^3.0.8"
  }
}
